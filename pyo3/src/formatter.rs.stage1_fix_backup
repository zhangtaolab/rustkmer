    /// Convert database statistics to JSON format
    ///
    /// Returns a JSON string containing database metadata.
    ///
    /// # Returns
    /// * `String` - JSON formatted string
    ///
    /// # Example
    /// ```python
    /// stats = db.get_stats()
    /// json_str = stats.to_json()
    /// ```
    pub fn to_json(&self) -> PyResult<String> {
        let serializable = DatabaseStatsSerializable::from(self);
