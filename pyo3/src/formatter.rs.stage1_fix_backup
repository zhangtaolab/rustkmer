/// Formatting methods for PyFuzzyResult
impl crate::fuzzy_query::PyFuzzyResult {
    /// Convert fuzzy query result to JSON format
    ///
    /// Returns a JSON string containing all matches and query metadata.
    ///
    /// # Returns
    /// * `String` - JSON formatted string
    ///
    /// # Example
    /// ```python
    /// result = fuzzy_query.query_fuzzy("ATNG", max_mutations=2)
    /// json_str = result.to_json()
    /// ```
    pub fn to_json(&self) -> PyResult<String> {
        let serializable = FuzzyResultSerializable::from(self);
        serde_json::to_string_pretty(&serializable)
            .map_err(|e| PyErr::new::<pyo3::exceptions::PyRuntimeError, _>(e.to_string()))
    }

    /// Convert fuzzy query result to CSV format
    ///
    /// Returns a CSV formatted string with all fuzzy matches.
    /// Includes header row and a metadata section at the end.
    ///
    /// # Returns
    /// * `String` - CSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = fuzzy_query.query_fuzzy("ATNG", max_mutations=2)
    /// csv_str = result.to_csv()
    /// # kmer,count,distance,match_type,mutation_positions
    /// # ATCG,5,0,exact,"[]"
    /// # ATGC,3,1,mutation_tolerance,"[2]"
    /// # ...
    /// ```
    pub fn to_csv(&self) -> PyResult<String> {
        let mut csv = String::new();
        csv.push_str("kmer,count,distance,match_type,mutation_positions\n");

        // Add exact match first if present
        if let Some(ref exact) = self.exact_match {
            csv.push_str(&format!(
                "{},{},{},{},\"{:?}\"\n",
                exact.kmer,
                exact.count,
                exact.distance.unwrap_or(0),
                exact.match_type,
                exact.mutation_positions
            ));
        }

        // Add other matches
        for match_item in &self.matches {
            // Skip exact match if already added
            if match_item.match_type == "exact" {
                if let Some(ref exact) = self.exact_match {
                    if match_item.kmer == exact.kmer {
                        continue;
                    }
                }
            }

            csv.push_str(&format!(
                "{},{},{},{},\"{:?}\"\n",
                match_item.kmer,
                match_item.count,
                match_item.distance.unwrap_or(0),
                match_item.match_type,
                match_item.mutation_positions
            ));
        }

        // Add metadata as comments
        csv.push_str(&format!("# query_kmer={}\n", self.query_kmer));
        csv.push_str(&format!("# total_matches={}\n", self.total_matches));
        csv.push_str(&format!(
            "# mutation_tolerance={}\n",
            self.mutation_tolerance
        ));
        csv.push_str(&format!("# query_time_ms={}\n", self.query_time_ms));
        csv.push_str(&format!(
            "# has_position_mutations={}\n",
            self.has_position_mutations
        ));

        Ok(csv)
    }

    /// Convert fuzzy query result to TSV format
    ///
    /// Returns a TSV (Tab-Separated Values) formatted string with all fuzzy matches.
    ///
    /// # Returns
    /// * `String` - TSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = fuzzy_query.query_fuzzy("ATNG", max_mutations=2)
    /// tsv_str = result.to_tsv()
    /// ```
    pub fn to_tsv(&self) -> PyResult<String> {
        let mut tsv = String::new();
        tsv.push_str("kmer\tcount\tdistance\tmatch_type\tmutation_positions\n");

        // Add exact match first if present
        if let Some(ref exact) = self.exact_match {
            tsv.push_str(&format!(
                "{}\t{}\t{}\t{}\t{:?}\n",
                exact.kmer,
                exact.count,
                exact.distance.unwrap_or(0),
                exact.match_type,
                exact.mutation_positions
            ));
        }

        // Add other matches
        for match_item in &self.matches {
            // Skip exact match if already added
            if match_item.match_type == "exact" {
                if let Some(ref exact) = self.exact_match {
                    if match_item.kmer == exact.kmer {
                        continue;
                    }
                }
            }

            tsv.push_str(&format!(
                "{}\t{}\t{}\t{}\t{:?}\n",
                match_item.kmer,
                match_item.count,
                match_item.distance.unwrap_or(0),
                match_item.match_type,
                match_item.mutation_positions
            ));
        }

        // Add metadata as comments
        tsv.push_str(&format!("# query_kmer={}\n", self.query_kmer));
        tsv.push_str(&format!("# total_matches={}\n", self.total_matches));
        tsv.push_str(&format!(
            "# mutation_tolerance={}\n",
            self.mutation_tolerance
        ));
        tsv.push_str(&format!("# query_time_ms={}\n", self.query_time_ms));
        tsv.push_str(&format!(
            "# has_position_mutations={}\n",
            self.has_position_mutations
        ));

        Ok(tsv)
    }
}

