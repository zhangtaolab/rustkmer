/// Formatting methods for PyQueryResult
impl crate::database::PyQueryResult {
    /// Convert query result to JSON format
    ///
    /// Returns a JSON string containing the k-mer, count, and found status.
    ///
    /// # Returns
    /// * `String` - JSON formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_exact("ATCG")
    /// json_str = result.to_json()
    /// # {"kmer":"ATCG","count":5,"found":true}
    /// ```
    pub fn to_json(&self) -> PyResult<String> {
        let serializable = QueryResultSerializable::from(self);
        serde_json::to_string_pretty(&serializable)
            .map_err(|e| PyErr::new::<pyo3::exceptions::PyRuntimeError, _>(e.to_string()))
    }

    /// Convert query result to CSV format
    ///
    /// Returns a CSV formatted string with header row.
    ///
    /// # Returns
    /// * `String` - CSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_exact("ATCG")
    /// csv_str = result.to_csv()
    /// # kmer,count,found
    /// # ATCG,5,true
    /// ```
    pub fn to_csv(&self) -> PyResult<String> {
        let mut csv = String::new();
        csv.push_str("kmer,count,found\n");
        csv.push_str(&format!("{},{},{}\n", self.kmer, self.count, self.found));
        Ok(csv)
    }

    /// Convert query result to TSV format
    ///
    /// Returns a TSV (Tab-Separated Values) formatted string with header row.
    ///
    /// # Returns
    /// * `String` - TSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_exact("ATCG")
    /// tsv_str = result.to_tsv()
    /// # kmer\tcount\tfound
    /// # ATCG\t5\ttrue
    /// ```
    pub fn to_tsv(&self) -> PyResult<String> {
        let mut tsv = String::new();
        tsv.push_str("kmer\tcount\tfound\n");
        tsv.push_str(&format!("{}\t{}\t{}\n", self.kmer, self.count, self.found));
        Ok(tsv)
    }

    /// Convert query result to Python dict
    ///
    /// Returns a Python dictionary containing k-mer, count, and found status.
    ///
    /// # Returns
    /// * `Py<PyDict>` - Python dictionary with result fields
    ///
    /// # Example
    /// ```python
    /// result = db.query_exact("ATCG")
    /// data = result.to_dict()
    /// # {'kmer': 'ATCG', 'count': 5, 'found': True}
    /// ```
    pub fn to_dict(&self, py: Python<'_>) -> PyResult<Py<PyDict>> {
        let dict = PyDict::new(py);
        dict.set_item("kmer", &self.kmer)?;
        dict.set_item("count", self.count)?;
        dict.set_item("found", self.found)?;
        Ok(dict.unbind())
    }
}

