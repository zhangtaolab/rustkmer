/// Formatting methods for PyPrefixQueryResult
impl crate::database::PyPrefixQueryResult {
    /// Convert prefix query result to JSON format
    ///
    /// Returns a JSON string containing all matches and metadata.
    ///
    /// # Returns
    /// * `String` - JSON formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_prefix("ATCG")
    /// json_str = result.to_json()
    /// ```
    pub fn to_json(&self) -> PyResult<String> {
        let serializable = PrefixQueryResultSerializable::from(self);
        serde_json::to_string_pretty(&serializable)
            .map_err(|e| PyErr::new::<pyo3::exceptions::PyRuntimeError, _>(e.to_string()))
    }

    /// Convert prefix query result to CSV format
    ///
    /// Returns a CSV formatted string with all matching k-mers and their counts.
    /// Includes header row and a metadata section at the end.
    ///
    /// # Returns
    /// * `String` - CSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_prefix("AT")
    /// csv_str = result.to_csv()
    /// # kmer,count
    /// # ATCG,5
    /// # ATGC,3
    /// # ...
    /// # # total_matches=100,query_time_ms=5
    /// ```
    pub fn to_csv(&self) -> PyResult<String> {
        let mut csv = String::new();
        csv.push_str("kmer,count\n");

        // Sort matches for consistent output
        let mut matches_vec: Vec<_> = self.matches.iter().collect();
        matches_vec.sort_by_key(|&(k, _)| k);

        for (kmer, count) in matches_vec {
            csv.push_str(&format!("{},{}\n", kmer, count));
        }

        // Add metadata as comments
        csv.push_str(&format!("# total_matches={}\n", self.total_matches));
        csv.push_str(&format!("# query_time_ms={}\n", self.query_time_ms));
        csv.push_str(&format!("# start_index={}\n", self.start_index));
        csv.push_str(&format!("# end_index={}\n", self.end_index));
        csv.push_str(&format!("# block_size={}\n", self.block_size));
        csv.push_str(&format!("# is_sorted={}\n", self.is_sorted));

        Ok(csv)
    }

    /// Convert prefix query result to TSV format
    ///
    /// Returns a TSV (Tab-Separated Values) formatted string with all matching k-mers.
    ///
    /// # Returns
    /// * `String` - TSV formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_prefix("AT")
    /// tsv_str = result.to_tsv()
    /// ```
    pub fn to_tsv(&self) -> PyResult<String> {
        let mut tsv = String::new();
        tsv.push_str("kmer\tcount\n");

        // Sort matches for consistent output
        let mut matches_vec: Vec<_> = self.matches.iter().collect();
        matches_vec.sort_by_key(|&(k, _)| k);

        for (kmer, count) in matches_vec {
            tsv.push_str(&format!("{}\t{}\n", kmer, count));
        }

        // Add metadata as comments
        tsv.push_str(&format!("# total_matches={}\n", self.total_matches));
        tsv.push_str(&format!("# query_time_ms={}\n", self.query_time_ms));
        tsv.push_str(&format!("# start_index={}\n", self.start_index));
        tsv.push_str(&format!("# end_index={}\n", self.end_index));
        tsv.push_str(&format!("# block_size={}\n", self.block_size));
        tsv.push_str(&format!("# is_sorted={}\n", self.is_sorted));

        Ok(tsv)
    }

    /// Convert prefix query result to table format
    ///
    /// Returns a formatted ASCII table with column headers and aligned data.
    ///
    /// # Returns
    /// * `String` - Table formatted string
    ///
    /// # Example
    /// ```python
    /// result = db.query_prefix("AT")
    /// table_str = result.to_table()
    /// # +------+-------+
    /// # | kmer | count |
    /// # +------+-------+
    /// # | ATCG |     5 |
    /// # | ATGC |     3 |
    /// # +------+-------+
    /// # Total matches: 100
    /// # Query time: 5ms
    /// ```
    pub fn to_table(&self) -> PyResult<String> {
        let mut table = String::new();

        // Calculate column widths
        let max_kmer_width = self
            .matches
            .keys()
            .map(|k| k.len())
            .max()
            .unwrap_or("kmer".len())
            .max("kmer".len());
        let max_count_width = self
            .matches
            .values()
            .map(|v| v.len())
            .max()
            .unwrap_or("count".len())
            .max("count".len());

        let kmer_width = max_kmer_width.max(4);
        let count_width = max_count_width.max(5);

        // Create top border
        table.push_str(&format!("+-{:-<}-+-{:-<}-+\n", kmer_width, count_width));

        // Create header
        table.push_str(&format!(
            "| {:^width$} | {:^width2$} |\n",
            "kmer",
            "count",
            width = kmer_width,
            width2 = count_width
        ));

        // Create separator
        table.push_str(&format!("+={:=<}-+={:=<}-+\n", kmer_width, count_width));

        // Sort matches for consistent output
        let mut matches_vec: Vec<_> = self.matches.iter().collect();
        matches_vec.sort_by_key(|&(k, _)| k);

        // Add data rows
        for (kmer, count) in matches_vec {
            table.push_str(&format!(
                "| {:<width$} | {:>width2$} |\n",
                kmer,
                count,
                width = kmer_width,
                width2 = count_width
            ));
        }

        // Create bottom border
        table.push_str(&format!("+-{:-<}-+-{:-<}-+\n", kmer_width, count_width));

        // Add metadata section
        table.push_str(&format!("\nTotal matches: {}\n", self.total_matches));
        table.push_str(&format!("Query time: {}ms\n", self.query_time_ms));
        table.push_str(&format!(
            "Memory block: [{}, {}) size={}\n",
            self.start_index, self.end_index, self.block_size
        ));
        table.push_str(&format!("Sorted: {}\n", self.is_sorted));

        Ok(table)
    }
}

